#!/usr/bin/env bash
# ==============================================================================
# rc: manage Claude Code remote-control roles (one claude-remote-control@<role> user unit each)
# Roles: ~/.config/claude-rc/<role>.conf (predefined ones from Ansible ai_workstation, custom ones
# from `rc new`, folders in ~/Obsidian/Adrixan/AI/Roles). Only the greeter starts at boot.
# Workspace trust stays a manual step: `cd <folder> && claude` once and accept the dialog.
# Usage:
#   rc ls                                   roles with state, sessions, last activity, memory
#   rc up <role> [--ttl 4h] [--fresh] [--force]  resumes the last session (relay keeps it ~4 h after a stop)
#   rc down <role> [--force]                refuses while a session was active in the last 15 min
#   rc restart <role> [--force]
#   rc new <name> [--label L] [--dir D] [--plugins dev,research,travel] [--brief TEXT]
#          [--description TEXT] [--args "--spawn worktree"]
#   rc rm <name> [--force]                  custom roles only; keeps the folder
#   rc logs <role> [lines]
#   rc trip <destination> [up options]      role trip-<slug> in ~/Obsidian/Adrixan/Travel/Trips/<slug>
#                                           (created on first use, resumed later)
#   rc trips                                trip roles, most recently active first
#   rc projects                             folders in ~/code, most recently used first
#   rc code <project> [up options]          role code-<project>, served from the helper folder
#                                           ~/code/.rc/<project> (inherits the ~/code trust), any
#                                           number in parallel
#   rc code --new <name> [up options]       creates ~/code/<name> with a minimal AGENTS.md first
#   rc code --own <project> [up options]    own role code-<project> in the project folder (client repos;
#                                           needs the repository's own trust)
#   rc menu                                 running roles, stopped roles, trips, recent projects, RAM
#   rc restore                              starts the roles that ran before a reboot (rc up marks them)
#   rc hook code-session|greeter-start      SessionStart hooks of ~/code and of the Greeter
# <role> is the role name or its label (case-insensitive).
# ==============================================================================

set -euo pipefail

CONF_DIR="${HOME}/.config/claude-rc"
ROLES_ROOT="${HOME}/Obsidian/Adrixan/AI/Roles"
TRIPS_DIR="${HOME}/Obsidian/Adrixan/Travel/Trips"
CODE_DIR="${HOME}/code"
PROJECTS_DIR="${HOME}/.claude/projects"
CLAUDE_STATE="${HOME}/.claude.json"
MIN_AVAILABLE_MB=1024
BUSY_MINUTES=15
CUSTOM_MARKER="# Created by rc new"
OPTIONAL_PLUGINS=(dev research travel)
# One server per folder (a second `claude remote-control` in a folder is refused) and a repository in
# ~/code is untrusted on its own, so each project runs in a helper folder ~/code/.rc/<project>: not a
# git repository, so it inherits the ~/code trust; auto mode edits the project outside that folder
SLOTS_DIR="${CODE_DIR}/.rc"
STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/claude-rc"
FOCUS_SESSIONS="${STATE_DIR}/code-focus-sessions"
FOCUS_LOG="${STATE_DIR}/code-focus.log"
FOCUS_REMOTE="${STATE_DIR}/code-focus-remote"  # cse_<id> of a session -> project
PROJECT_RE='^[A-Za-z0-9][A-Za-z0-9._-]{0,60}$'
# Roles started with rc up and not stopped with rc down; the Greeter's start hook brings them back
WANTED_DIR="${STATE_DIR}/wanted"
RC_BIN="$(realpath -- "$0")"
RESUME_HOURS=4

die() { echo "rc: $*" >&2; exit 1; }
unit() { echo "claude-remote-control@$1.service"; }

usage() {
    sed -n '/^# Usage:/,/^# <role>/p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
}

conf_get() {  # conf_get <role> <KEY>
    sed -n "s/^$2=\"\(.*\)\"\$/\1/p" "${CONF_DIR}/$1.conf"
}

resolve() {  # role name or label -> role name
    local want="${1,,}" f name
    [[ -f "${CONF_DIR}/${want}.conf" ]] && { echo "$want"; return; }
    for f in "${CONF_DIR}"/*.conf; do
        name="$(basename "$f" .conf)"
        [[ "$(conf_get "$name" RC_NAME | tr '[:upper:]' '[:lower:]')" == "$want" ]] && { echo "$name"; return; }
    done
    die "unknown role '$1' (rc ls lists them)"
}

main_pid() { systemctl --user show -p MainPID --value "$(unit "$1")"; }

sessions() {  # one `claude --print --sdk-url` child per session
    local pid; pid="$(main_pid "$1")"
    [[ "$pid" != 0 ]] || { echo 0; return; }
    { pgrep -P "$pid" -f -- '--sdk-url' || true; } | wc -l  # pgrep exits 1 while no session runs yet
}

project_dir() { echo "${PROJECTS_DIR}/$(conf_get "$1" RC_DIR | sed 's/[^A-Za-z0-9]/-/g')"; }

last_active_min() {  # minutes since the newest transcript changed, or empty
    local newest
    # Empty transcripts are standby sessions the server pre-created, not activity
    newest="$(find "$(project_dir "$1")" -maxdepth 1 -name '*.jsonl' -size +0 -printf '%T@\n' 2>/dev/null | sort -n | tail -1)"
    [[ -n "$newest" ]] && echo $(( ( $(date +%s) - ${newest%.*} ) / 60 ))
    return 0
}

memory_mb() {  # resident memory of every process in the unit's cgroup
    local cg kb=0 p
    cg="$(systemctl --user show -p ControlGroup --value "$(unit "$1")")"
    [[ -n "$cg" && -r "/sys/fs/cgroup${cg}/cgroup.procs" ]] || { echo 0; return; }
    while read -r p; do
        kb=$(( kb + $(awk '/^VmRSS/{print $2}' "/proc/$p/status" 2>/dev/null || echo 0) ))
    done < "/sys/fs/cgroup${cg}/cgroup.procs"
    echo $(( kb / 1024 ))
}

plugins_off() {  # optional plugins switched off in the role folder
    local settings off=() p
    settings="$(conf_get "$1" RC_DIR)/.claude/settings.json"
    [[ -r "$settings" ]] || { echo "all"; return; }
    [[ "$(jq -r '.enabledPlugins["workstation-mcp@workstation"] == false' "$settings")" == true ]] && { echo "none"; return; }
    for p in "${OPTIONAL_PLUGINS[@]}"; do
        [[ "$(jq -r --arg k "workstation-$p@workstation" '.enabledPlugins[$k] == false' "$settings")" == true ]] && off+=("$p")
    done
    if [[ ${#off[@]} -gt 0 ]]; then (IFS=,; echo "no ${off[*]}"); else echo "all"; fi
}

is_trusted() {  # the folder, or for a non-git folder an ancestor, has accepted workspace trust
    local dir="$1" top
    top="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || true)"
    [[ -n "$top" ]] && dir="$top"
    jq -e --arg d "$dir" '.projects[$d].hasTrustDialogAccepted == true' "$CLAUDE_STATE" >/dev/null && return 0
    [[ -n "$top" ]] && return 1  # a nested repository needs its own trust
    while dir="$(dirname "$dir")"; [[ "$dir" != "$HOME" && "$dir" != / ]]; do
        jq -e --arg d "$dir" '.projects[$d].hasTrustDialogAccepted == true' "$CLAUDE_STATE" >/dev/null && return 0
    done
    return 1  # home-directory trust is never saved, so the walk stops below it
}

available_mb() { awk '/^MemAvailable/{print int($2/1024)}' /proc/meminfo; }

busy_guard() {  # refuse to end sessions that were active recently
    local role="$1" force="$2" idle
    [[ "$force" == yes ]] && return 0
    idle="$(last_active_min "$role")"
    if [[ -n "$idle" && "$idle" -lt "$BUSY_MINUTES" && "$(sessions "$role")" -gt 0 ]]; then
        die "$role had session activity ${idle} min ago; this ends its sessions (use --force)"
    fi
}

cmd_ls() {
    local f role state sess idle mem
    printf '%-10s %-15s %-9s %-4s %-8s %-6s %-16s %s\n' ROLE LABEL STATE SESS LAST_ACT MEM_MB PLUGINS DESCRIPTION
    for f in "${CONF_DIR}"/*.conf; do
        role="$(basename "$f" .conf)"
        state="$(systemctl --user is-active "$(unit "$role")" 2>/dev/null || true)"
        [[ "$(conf_get "$role" RC_AUTOSTART)" == yes ]] && state="${state}*"
        sess="-"; mem="-"; idle="$(last_active_min "$role")"
        if [[ "$state" == active* ]]; then sess="$(sessions "$role")"; mem="$(memory_mb "$role")"; fi
        printf '%-10s %-15s %-9s %-4s %-8s %-6s %-16s %s%s\n' "$role" "$(conf_get "$role" RC_NAME)" "$state" "$sess" \
            "${idle:+${idle}m}" "$mem" "$(plugins_off "$role")" "$(conf_get "$role" RC_DESCRIPTION)" \
            "$(grep -qxF "$CUSTOM_MARKER" "$f" && echo ' [custom]' || true)"
    done
    echo
    echo "* starts at boot. RAM available: $(available_mb) MB. Shared MCP service: $(systemctl --user is-active mcp-shared.service 2>/dev/null || true)"
}

fresh_pointer() {  # next start creates a new session instead of reattaching the last one
    local pointer; pointer="$(project_dir "$1")/bridge-pointer.json"
    if [[ -f "$pointer" ]]; then
        mv -- "$pointer" "${pointer}.$(date +%Y%m%d%H%M%S).bak"
        echo "fresh session for $1"
    fi
}

stopped_hours() {  # hours since the role's server stopped, empty without a previous session
    local role="$1" pointer stopped since
    pointer="$(project_dir "$role")/bridge-pointer.json"
    [[ -f "$pointer" ]] || return 0
    # A stopped template instance is unloaded, so its timestamps are empty: take the journal's last stop
    stopped="$(journalctl --user -u "$(unit "$role")" -o short-unix --no-pager --grep '^Stopped ' 2>/dev/null | tail -1 | cut -d' ' -f1)"
    since="${stopped%.*}"
    [[ "$since" =~ ^[0-9]+$ ]] || since="$(stat -c %Y "$pointer")"
    echo $(( ( $(date +%s) - since ) / 3600 ))
}

resume_info() {  # a restart reattaches the previous session for about 4 h after the stop (relay limit)
    local role="$1" hours
    hours="$(stopped_hours "$role")"
    if [[ -z "$hours" ]]; then
        echo "no previous session: a new one starts"
    elif [[ "$hours" -lt "$RESUME_HOURS" ]]; then
        echo "resuming the previous session ($(jq -r '.sessionId // "unknown"' "$(project_dir "$role")/bridge-pointer.json"), stopped ${hours} h ago)"
    else
        echo "previous session stopped ${hours} h ago, past the ~${RESUME_HOURS} h reattach window: a new session starts and reads .agents/session-handoff.md"
    fi
}

want() { mkdir -p "$WANTED_DIR"; touch -- "${WANTED_DIR}/$1"; }
unwant() { rm -f -- "${WANTED_DIR}/$1"; }

cmd_up() {
    local role ttl="" fresh=no force=no dir
    role="$(resolve "${1:?role missing}")"; shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ttl) ttl="${2:?--ttl needs a duration such as 4h}"; shift 2 ;;
            --fresh) fresh=yes; shift ;;
            --force) force=yes; shift ;;
            *) usage ;;
        esac
    done
    if systemctl --user is-active --quiet "$(unit "$role")"; then
        want "$role"
        echo "$role is already running ($(sessions "$role") sessions)"
        return
    fi
    dir="$(conf_get "$role" RC_DIR)"
    [[ -d "$dir" ]] || die "folder missing: $dir"
    is_trusted "$dir" || die "$dir is not trusted: run 'cd \"$dir\" && claude' once in a terminal and accept the dialog"
    if [[ "$force" != yes && "$(available_mb)" -lt "$MIN_AVAILABLE_MB" ]]; then
        die "only $(available_mb) MB RAM available (minimum ${MIN_AVAILABLE_MB}); stop a role or use --force"
    fi
    if [[ "$fresh" == yes ]]; then fresh_pointer "$role"; else resume_info "$role"; fi
    systemctl --user start "$(unit "$role")"
    want "$role"
    if [[ -n "$ttl" ]]; then
        systemctl --user stop "rc-ttl-${role}.timer" 2>/dev/null || true
        # rc down, so the expired role is not brought back after a reboot
        systemd-run --user --quiet --unit "rc-ttl-${role}" --on-active="$ttl" --timer-property=AccuracySec=1min \
            "$RC_BIN" down "$role" --force
        echo "auto-stop in $ttl"
    fi
    echo "started $role: open the session \"$(conf_get "$role" RC_NAME)\" in the Claude app (appears within about 30 s)"
}

cmd_down() {
    local role force=no
    role="$(resolve "${1:?role missing}")"; shift
    [[ "${1:-}" == --force ]] && force=yes
    systemctl --user is-active --quiet "$(unit "$role")" || { unwant "$role"; echo "$role is not running"; return; }
    busy_guard "$role" "$force"
    systemctl --user stop "$(unit "$role")"
    unwant "$role"
    systemctl --user stop "rc-ttl-${role}.timer" 2>/dev/null || true
    echo "stopped $role (starting it again works after about 1 to 2 min)"
}

cmd_restart() {
    local role force=no
    role="$(resolve "${1:?role missing}")"; shift
    [[ "${1:-}" == --force ]] && force=yes
    busy_guard "$role" "$force"
    systemctl --user restart "$(unit "$role")"
    echo "restarted $role (the unit retries for about 1 to 2 min until the relay accepts it)"
}

safe_value() {  # values go into a systemd EnvironmentFile inside double quotes
    [[ "$1" != *[\"\$\`\\]* && "$1" != *$'\n'* ]] || die "value must not contain quotes, \$, backticks, backslashes or newlines: $1"
}

cmd_new() {
    local name="${1:?name missing}" label="" dir="" plugins="" brief="" description="" args="" files=yes p v enabled conf
    shift
    [[ "$name" =~ ^[a-z][a-z0-9-]{1,39}$ ]] || die "name: lowercase letters, digits and hyphens, 2 to 40 characters"
    [[ -e "${CONF_DIR}/${name}.conf" ]] && die "role $name exists"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --label) label="$2"; shift 2 ;;
            --dir) dir="$2"; shift 2 ;;
            --plugins) plugins="$2"; shift 2 ;;
            --brief) brief="$2"; shift 2 ;;
            --description) description="$2"; shift 2 ;;
            --args) args="$2"; shift 2 ;;
            --no-files) files=no; shift ;;  # existing project: write nothing into its folder
            *) usage ;;
        esac
    done
    label="${label:-${name^}}"; dir="${dir:-${ROLES_ROOT}/${name}}"; description="${description:-${brief%%.*}}"
    for p in "$label" "$dir" "$description" "$args"; do safe_value "$p"; done
    for p in ${plugins//,/ }; do
        [[ " ${OPTIONAL_PLUGINS[*]} " == *" $p "* ]] || die "unknown plugin '$p' (dev, research, travel)"
    done
    dir="$(realpath -m -- "$dir")"
    if [[ "$files" == yes ]]; then
        mkdir -p "$dir/.claude"
        if [[ ! -e "$dir/AGENTS.md" ]]; then
            printf '# %s\n\n%s\n' "$label" "${brief:-Custom role created with rc new.}" > "$dir/AGENTS.md"
            printf '@AGENTS.md\n' > "$dir/CLAUDE.md"
        fi
        enabled="{}"
        for p in "${OPTIONAL_PLUGINS[@]}"; do
            if [[ ",${plugins}," == *",${p},"* ]]; then v=true; else v=false; fi
            enabled="$(jq -c --arg k "workstation-$p@workstation" --argjson v "$v" '. + {($k): $v}' <<< "$enabled")"
        done
        if [[ -f "$dir/.claude/settings.json" ]]; then
            jq --argjson e "$enabled" '.enabledPlugins = ((.enabledPlugins // {}) + $e)' "$dir/.claude/settings.json" > "$dir/.claude/settings.json.tmp"
            mv -- "$dir/.claude/settings.json.tmp" "$dir/.claude/settings.json"
        else
            jq -n --argjson e "$enabled" '{enabledPlugins: $e}' > "$dir/.claude/settings.json"
        fi
    fi
    [[ -d "$dir" ]] || die "folder missing: $dir"
    conf="${CONF_DIR}/${name}.conf"
    printf '%s\nRC_DIR="%s"\nRC_NAME="%s"\nRC_ARGS="%s"\nRC_AUTOSTART="no"\nRC_DESCRIPTION="%s"\n' \
        "$CUSTOM_MARKER" "$dir" "$label" "$args" "$description" > "$conf"
    echo "created role $name in $dir (plugins: $([[ "$files" == yes ]] && echo "core${plugins:+,$plugins}" || echo "user defaults"))"
    is_trusted "$dir" || echo "not trusted yet: run 'cd \"$dir\" && claude' once in a terminal and accept the dialog"
}

slugify() {  # "Prague / Praha" -> prague-praha
    iconv -f UTF-8 -t ASCII//TRANSLIT <<< "$1" 2>/dev/null | tr '[:upper:]' '[:lower:]' \
        | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-34
}

trip_brief() {  # AGENTS.md of a new trip role
    cat <<EOF
Trip planning role for $1, one of several trips planned in parallel (each trip has its own folder in
\`~/Obsidian/Adrixan/Travel/Trips/\` and its own role \`trip-<slug>\`).

- Follow the travel standing order: first read the memory entities \`Travel planning\`, \`Packing lists\`,
  \`Travel history\`, \`Peter Aufner\`, \`Julia\`, \`Solveig\` and \`Elenore\`, and the Travel section of
  \`~/sync/ai/WORKSTATION-details.md\`.
- Keep this trip's state in this folder so a later session can restore it: \`trip.md\` (dates,
  travellers, decisions, open questions, trip-planner slug) and \`.agents/session-handoff.md\`, both
  updated after every planning step.
- Publish through MCP \`trip-planner\` (one slug per trip; new documents start hidden), look things up
  with \`trip-scout\`. Write German, "du" form, for the participants.
EOF
}

cmd_trip() {
    local dest="${1:?destination missing}" slug role
    shift
    slug="$(slugify "$dest")"
    [[ -n "$slug" ]] || die "destination needs letters or digits: $dest"
    role="trip-${slug}"
    if [[ ! -e "${CONF_DIR}/${role}.conf" ]]; then
        cmd_new "$role" --label "Trip ${dest}" --dir "${TRIPS_DIR}/${slug}" --plugins travel,research \
            --description "Trip planning: ${dest}" --brief "$(trip_brief "$dest")"
    fi
    cmd_up "$role" "$@"
}

cmd_trips() {
    local f role
    compgen -G "${CONF_DIR}/trip-*.conf" >/dev/null || { echo "no trips yet: rc trip <destination>"; return; }
    for f in "${CONF_DIR}"/trip-*.conf; do
        role="$(basename "$f" .conf)"
        printf '%s\t%s\t%s\t%s\n' "$(last_active_min "$role")" "$role" "$(conf_get "$role" RC_NAME)" \
            "$(systemctl --user is-active "$(unit "$role")" 2>/dev/null || true)"
    done | sort -n | awk -F'\t' 'BEGIN{printf "%-26s %-22s %-9s %s\n","ROLE","LABEL","STATE","LAST_ACT"} {printf "%-26s %-22s %-9s %s\n",$2,$3,$4,($1==""?"-":$1"m")}'
}

code_role() { echo "code-$(slugify "$1")"; }

project_name() {  # exact or case-insensitive folder name in ~/code ("linguafusion" -> LinguaFusion)
    local want="$1" match
    [[ "$want" =~ $PROJECT_RE ]] || die "project name: letters, digits, dot, underscore, hyphen"
    [[ -d "${CODE_DIR}/${want}" ]] && { echo "$want"; return; }
    match="$(find "$CODE_DIR" -mindepth 1 -maxdepth 1 -type d -iname "$want" -printf '%f\n' | head -1)"
    [[ -n "$match" ]] || die "no project '$want' in $CODE_DIR (rc projects lists them)"
    echo "$match"
}

client_repo() {  # claude-client-init settings, which a session started outside the repo would not load
    local s="$1/.claude/settings.json"
    [[ -r "$s" ]] && jq -e '((.deniedMcpServers // []) | length > 0) or .disableClaudeAiConnectors == true' "$s" >/dev/null
}

transcript_epoch() {  # newest non-empty transcript of sessions started in the folder, or empty
    find "${PROJECTS_DIR}/$(sed 's/[^A-Za-z0-9]/-/g' <<< "$1")" -maxdepth 1 -name '*.jsonl' -size +0 -printf '%T@\n' 2>/dev/null | sort -n | tail -1 | cut -d. -f1
    return 0
}

project_rows() {  # TSV: last use (epoch), project, git, note; most recent first
    local d name act slot_act git note role t p
    local -A focused=()
    if [[ -r "$FOCUS_LOG" ]]; then  # chronological, so the last line per project wins
        while IFS=$'\t' read -r t p; do [[ "$t" =~ ^[0-9]+$ && -n "$p" ]] && focused[$p]="$t"; done < "$FOCUS_LOG"
    fi
    for d in "${CODE_DIR}"/*/; do
        d="${d%/}"; name="$(basename "$d")"
        if [[ -e "$d/.git" ]]; then git=yes; else git=no; fi
        # Last Claude session (bulk commits across all repos make commit dates useless): in the repo, in
        # its helper folder or focused from the general Code role, else the last commit
        act="$(transcript_epoch "$d")"; slot_act="$(transcript_epoch "${SLOTS_DIR}/${name}")"
        [[ "${slot_act:-0}" -gt "${act:-0}" ]] && act="$slot_act"
        [[ "${focused[$name]:-0}" -gt "${act:-0}" ]] && act="${focused[$name]}"
        [[ -n "$act" ]] || act="$(git -C "$d" log -1 --format=%ct 2>/dev/null || stat -c %Y "$d")"
        note="-"
        client_repo "$d" && note="client repo: rc code --own"
        role="$(code_role "$name")"
        if [[ -e "${CONF_DIR}/${role}.conf" ]] && systemctl --user is-active --quiet "$(unit "$role")"; then note="running"; fi
        printf '%s\t%s\t%s\t%s\n' "$act" "$name" "$git" "$note"
    done | sort -rn
}

cmd_projects() {
    project_rows | awk -F'\t' -v now="$(date +%s)" \
        'BEGIN{printf "%-36s %-4s %-9s %s\n","PROJECT","GIT","LAST_USED","NOTE"} {printf "%-36s %-4s %-9s %s\n",$2,$3,int((now-$1)/86400)"d",$4}'
    echo
    echo "Start one with: rc code <project>   New project: rc code --new <name>   Client repo: rc code --own <project>"
}

focus_of_remote() {  # project a session (cse_<id>) is focused on, or empty
    [[ "$1" =~ ^cse_[A-Za-z0-9]+$ && -f "${FOCUS_REMOTE}/$1" ]] && cat -- "${FOCUS_REMOTE}/$1"
    return 0
}

remote_session_id() {  # cse_<id> of the `claude --sdk-url` process this hook runs under
    local pid="$PPID" i id
    for i in 1 2 3 4 5 6; do
        [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 1 && -r "/proc/$pid/cmdline" ]] || return 0
        id="$(tr '\0' '\n' < "/proc/$pid/cmdline" | sed -n '/^--session-id$/{n;p;q}')"
        [[ "$id" =~ ^cse_[A-Za-z0-9]+$ ]] && { echo "$id"; return 0; }
        pid="$(awk '/^PPid:/{print $2}' "/proc/$pid/status" 2>/dev/null || true)"
    done
    return 0
}

make_slot() {  # helper folder of a project role: only the focus hook, written by rc
    mkdir -p "$1/.claude"
    jq -n --arg c "\"\$HOME/.local/bin/rc\" hook code-session" \
        '{hooks: {SessionStart: [{matcher: "startup|resume|compact", hooks: [{type: "command", command: $c}]}]}}' \
        > "$1/.claude/settings.json"
}

cmd_code() {
    local project="${1:?project missing}" own=no dir role slot
    shift
    if [[ "$project" == --own ]]; then own=yes; project="${1:?project missing}"; shift; fi
    if [[ "$project" == --new ]]; then
        project="${1:?name missing}"; shift
        [[ "$project" =~ $PROJECT_RE ]] || die "project name: letters, digits, dot, underscore, hyphen"
        dir="${CODE_DIR}/${project}"
        [[ -e "$dir" ]] && die "$dir exists: use rc code $project"
        mkdir -p "$dir"
        printf '# %s\n\nNew project created %s. Describe goal, stack and conventions here; the global rules apply.\n' \
            "$project" "$(date +%F)" > "$dir/AGENTS.md"
        printf '@AGENTS.md\n' > "$dir/CLAUDE.md"
        echo "created $dir"
    else
        project="$(project_name "$project")"
    fi
    dir="${CODE_DIR}/${project}"
    role="$(code_role "$project")"
    if [[ -e "${CONF_DIR}/${role}.conf" ]]; then  # existing project role (helper folder or --own)
        [[ "$own" == yes && "$(conf_get "$role" RC_DIR)" != "$dir" ]] && die "$role runs from its helper folder: rc rm $role first"
        cmd_up "$role" "$@"
        return
    fi
    if [[ "$own" == yes ]]; then
        cmd_new "$role" --label "Code: ${project}" --dir "$dir" --description "Code project ${project} (own role in the repo)" --no-files
    else
        client_repo "$dir" && die "$project is a client repository: a session started outside it would bypass its MCP and connector denials; use rc code --own $project (needs the repository's own trust)"
        slot="${SLOTS_DIR}/${project}"
        make_slot "$slot"
        cmd_new "$role" --label "Code: ${project}" --dir "$slot" --description "Code project ${project}" --no-files
    fi
    cmd_up "$role" "$@"
}

focus_context() {  # additionalContext for a session focused on ~/code/<project>
    local p="$1" d="${CODE_DIR}/$1" from="$2" extra=""
    compgen -G "$d/.claude/settings*.json" >/dev/null && extra+=" Its .claude/ settings (permissions, hooks, plugins) are not loaded in this session: follow them by hand where they matter."
    [[ -e "$d/.mcp.json" ]] && extra+=" Its .mcp.json servers are not loaded; if a task needs them, ask Peter to start \`rc code --own $p\` (needs the repository's own trust)."
    printf '%s' "Code session focused on the project $p (~/code/$p). It runs from $from, which inherits the ~/code trust, so no extra approval is needed; treat ~/code/$p as the project root: read its AGENTS.md (or CLAUDE.md) and .agents/ state files before acting, run commands and git there (cd ~/code/$p), and keep its handoff in ~/code/$p/.agents/session-handoff.md. Touch other ~/code projects only when Peter asks.$extra"
}

cmd_restore() {  # start the roles that ran before a reboot; prints one summary line, or nothing
    local f role out ok=() failed=()
    [[ -d "$WANTED_DIR" ]] || return 0
    for f in "$WANTED_DIR"/*; do
        [[ -e "$f" ]] || continue
        role="$(basename "$f")"
        [[ "$role" != greeter && -f "${CONF_DIR}/${role}.conf" ]] || { rm -f -- "$f"; continue; }
        systemctl --user is-active --quiet "$(unit "$role")" && continue
        if out="$( (cmd_up "$role") 2>&1 )"; then
            ok+=("$(conf_get "$role" RC_NAME)")
        else
            failed+=("$(conf_get "$role" RC_NAME) (${out##*rc: })")
        fi
    done
    [[ ${#ok[@]} -gt 0 ]] && (IFS=,; echo "restarted after a reboot or crash: ${ok[*]}")
    [[ ${#failed[@]} -gt 0 ]] && (IFS=';'; echo "could not restart: ${failed[*]}")
    return 0
}

cmd_hook() {  # SessionStart hooks: code-session for Code and project roles, greeter-start for the Greeter
    if [[ "${1:-}" == greeter-start ]]; then
        local restored
        cat >/dev/null
        restored="$(cmd_restore | tr '\n' ' ')"
        jq -n --arg m "[greeter-start] Show the role menu.${restored:+ Put this in the status line: ${restored% }}" \
            '{hookSpecificOutput: {hookEventName: "SessionStart", initialUserMessage: $m}}'
        return 0
    fi
    [[ "${1:-}" == code-session ]] || usage
    local input src sid rid project="" context message="" seen=no
    input="$(cat)"
    case "${RC_DIR:-}" in  # only sessions of rc's servers; an interactive `claude` stays untouched
        "$CODE_DIR") ;;
        "$SLOTS_DIR"/*) project="${RC_DIR#"$SLOTS_DIR"/}" ;;
        *) return 0 ;;
    esac
    src="$(jq -r '.source // empty' <<< "$input")"
    sid="$(jq -r '.session_id // empty' <<< "$input")"
    [[ "$sid" =~ ^[A-Za-z0-9_-]{1,100}$ ]] || sid=""
    rid="$(remote_session_id)"  # stable when a restart reattaches the session
    mkdir -p "$FOCUS_SESSIONS" "$FOCUS_REMOTE"
    find "$FOCUS_REMOTE" "$FOCUS_SESSIONS" -maxdepth 1 -type f -mtime +30 -delete
    if [[ -z "$project" ]]; then  # general Code role: the focus a session chose earlier, if any
        project="$(focus_of_remote "$rid")"
        [[ -z "$project" && -n "$sid" && -f "${FOCUS_SESSIONS}/${sid}" ]] && project="$(<"${FOCUS_SESSIONS}/${sid}")"
    fi
    [[ -n "$(focus_of_remote "$rid")" || ( -n "$sid" && -f "${FOCUS_SESSIONS}/${sid}" ) ]] && seen=yes
    [[ "$project" =~ $PROJECT_RE && -d "${CODE_DIR}/${project}" ]] || project=""
    if [[ -n "$project" ]]; then
        [[ -n "$sid" ]] && printf '%s\n' "$project" > "${FOCUS_SESSIONS}/${sid}"
        [[ -n "$rid" ]] && printf '%s\n' "$project" > "${FOCUS_REMOTE}/${rid}"
        printf '%s\t%s\n' "$(date +%s)" "$project" >> "$FOCUS_LOG"
        context="$(focus_context "$project" "${RC_DIR/#$HOME/\~}")"
        # A reattached session already knows its project; a new one starts with a status turn
        [[ "$src" == startup && "$seen" == no ]] && message="[code-focus] ${project}: read the project's AGENTS.md and .agents/ state, then reply with a short status (branch, uncommitted changes, next steps from the handoff) and ask what to do."
    else
        context="General Code role session in ~/code without a chosen project. Unless Peter's first message names one, ask with AskUserQuestion which folder in ~/code to work on: run \`rc projects\` and offer the three most recently used by folder name plus \"New project\" (create ~/code/<name> with AGENTS.md and a CLAUDE.md containing @AGENTS.md); his free text takes any name. Then treat that folder as the project root: read its AGENTS.md and .agents/ state first, run commands and git there, keep its handoff in its .agents/. For a dedicated session per project (several in parallel), Peter uses the Greeter or \`rc code <project>\`. Projects whose .claude/settings.json denies MCP servers (client repositories) are off limits here: they need \`rc code --own <project>\`."
    fi
    jq -n --arg c "$context" --arg m "$message" \
        '{hookSpecificOutput: ({hookEventName: "SessionStart", additionalContext: $c} + (if $m == "" then {} else {initialUserMessage: $m} end))}'
}

cmd_menu() {  # one listing for the Greeter's menu
    local f role idle
    echo "RUNNING (label | role | sessions | last activity | MB):"
    for f in "${CONF_DIR}"/*.conf; do
        role="$(basename "$f" .conf)"
        [[ "$role" == greeter ]] && continue
        systemctl --user is-active --quiet "$(unit "$role")" || continue
        idle="$(last_active_min "$role")"
        printf '  %s | %s | %s | %s | %s\n' "$(conf_get "$role" RC_NAME)" "$role" "$(sessions "$role")" "${idle:+${idle} min ago}" "$(memory_mb "$role")"
    done
    echo "STOPPED ROLES, most recent first (label | role | last activity):"
    for f in "${CONF_DIR}"/*.conf; do
        role="$(basename "$f" .conf)"
        # Code starts per project and Travel Planner per trip (Peter, 2026-10-29), so neither is offered here
        [[ "$role" == greeter || "$role" == code || "$role" == travel || "$role" == code-* || "$role" == trip-* ]] && continue
        systemctl --user is-active --quiet "$(unit "$role")" && continue
        idle="$(last_active_min "$role")"
        printf '%s\t  %s | %s | %s\n' "${idle:-999999999}" "$(conf_get "$role" RC_NAME)" "$role" "${idle:+${idle} min ago}"
    done | sort -n | cut -f2-
    echo "TRIPS, most recent first (label | role | state | last activity):"
    for f in "${CONF_DIR}"/trip-*.conf; do
        [[ -e "$f" ]] || continue
        role="$(basename "$f" .conf)"
        idle="$(last_active_min "$role")"
        printf '%s\t  %s | %s | %s | %s\n' "${idle:-999999999}" "$(conf_get "$role" RC_NAME)" "$role" \
            "$(systemctl --user is-active "$(unit "$role")" 2>/dev/null || true)" "${idle:+${idle} min ago}"
    done | sort -n | cut -f2-
    echo "RECENT PROJECTS in ~/code (name | last used | note):"
    project_rows | head -6 | awk -F'\t' -v now="$(date +%s)" '{printf "  %s | %d d ago | %s\n",$2,(now-$1)/86400,$4}'
    echo "RAM available: $(available_mb) MB"
}

cmd_rm() {
    local role force=no
    role="$(resolve "${1:?role missing}")"; shift
    [[ "${1:-}" == --force ]] && force=yes
    grep -qxF "$CUSTOM_MARKER" "${CONF_DIR}/${role}.conf" || die "$role is predefined (managed by Ansible)"
    if systemctl --user is-active --quiet "$(unit "$role")"; then
        busy_guard "$role" "$force"
        systemctl --user stop "$(unit "$role")"
    fi
    echo "removed role $role; its folder stays: $(conf_get "$role" RC_DIR)"
    unwant "$role"
    rm -- "${CONF_DIR}/${role}.conf"
}

cmd_logs() {
    local role; role="$(resolve "${1:?role missing}")"
    journalctl --user -u "$(unit "$role")" -n "${2:-40}" --no-pager -o short-iso
}

[[ "${1:-}" == hook ]] && { shift; cmd_hook "$@"; exit 0; }  # also runs on machines without roles
[[ -d "$CONF_DIR" ]] || die "no role configs in $CONF_DIR"
case "${1:-ls}" in
    ls|list|status) cmd_ls ;;
    up|start) shift; cmd_up "$@" ;;
    down|stop) shift; cmd_down "$@" ;;
    restart) shift; cmd_restart "$@" ;;
    new|create) shift; cmd_new "$@"; echo "start it with: rc up $1" ;;
    rm|remove) shift; cmd_rm "$@" ;;
    logs) shift; cmd_logs "$@" ;;
    trip) shift; cmd_trip "$@" ;;
    trips) cmd_trips ;;
    projects) cmd_projects ;;
    code) shift; cmd_code "$@" ;;
    menu) cmd_menu ;;
    restore) cmd_restore ;;
    *) usage ;;
esac
