{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "instructions": ["~/sync/ai/WORKSTATION.md", "~/storage/shared/sync/ai/WORKSTATION.md"],
  "skills": { "paths": ["{{ env.HOME }}/.claude/plugins/marketplaces/claude-plugins-official/plugins/frontend-design/skills"] },
  "providers": {
    "anthropic": {
      "headers": {
        "anthropic-workspace-id": "{{ env.ANTHROPIC_WORKSPACE_ID }}"
      }
    },
    "dragtokens": {
      "name": "DragTokens",
      "canonical": "openai",
      "package": "@opencode/ai/providers/openai/responses",
      "settings": {
        "baseURL": "http://127.0.0.1:4097/v1",
        "apiKey": "{{ env.DRAGTOKENS_API_KEY }}"
      },
      "models": {
        "gpt-6-astra": {},
        "gpt-6.1-sol": {},
        "gpt-6-sol": {}
      }
    }
  },
  "model": "anthropic/claude-sonnet-4-5",
  "agents": {
    "plan": {
      "model": "dragtokens/gpt-6-astra"
    },
    "build": {
      "model": "dragtokens/gpt-6.1-sol"
    }
  },
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "Bearer {{ env.GITHUB_PERSONAL_ACCESS_TOKEN }}"
        },
        "oauth": false
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false
      },
      "playwright": {
        "type": "local",
        "command": [
          "/usr/local/bin/playwright-mcp",
          "--executable-path",
          "/usr/bin/chromium",
          "--headless",
          "--isolated",
          "--output-dir",
          "{{ env.HOME }}/.cache/playwright-mcp"
        ]
      },
      "memory": {
        "type": "local",
        "command": [
          "/usr/local/bin/mcp-server-memory"
        ],
        "environment": {
{% if env.TERMUX_VERSION != "" %}
          "MEMORY_FILE_PATH": "{{ env.HOME }}/storage/shared/sync/ai/mcp-memory.jsonl"
{% else %}
          "MEMORY_FILE_PATH": "{{ env.HOME }}/sync/ai/mcp-memory.jsonl"
{% endif %}
        }
      },
      "fetch": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/mcp-server-fetch"
        ]
      },
      "git": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/mcp-server-git"
        ]
      },
      "arxiv": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/arxiv-mcp-server",
          "--storage-path",
          "{{ env.HOME }}/Obsidian/Ph.D./Papers/arxiv"
        ]
      },
      "zotero": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/zotero-mcp"
        ],
        "environment": {
          "ZOTERO_LOCAL": "true"
        }
      },
      "markitdown": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/markitdown-mcp"
        ]
      },
      "serena": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/serena",
          "start-mcp-server",
          "--context",
          "ide",
          "--project-from-cwd",
          "--open-web-dashboard",
          "False"
        ],
        "disabled": false
      },
      "nextcloud": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/nextcloud-mcp-server",
          "run",
          "--transport",
          "stdio"
        ],
        "environment": {
          "NEXTCLOUD_HOST": "{{ env.NEXTCLOUD_HOST }}",
          "NEXTCLOUD_USERNAME": "{{ env.NEXTCLOUD_USERNAME }}",
          "NEXTCLOUD_PASSWORD": "{{ env.NEXTCLOUD_PASSWORD }}"
        },
        "disabled": false
      },
      "docker": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/mcp-server-docker"
        ],
        "environment": {
          "DOCKER_HOST": "tcp://127.0.0.1:2375"
        },
        "disabled": false
      }
    }
  }
}
