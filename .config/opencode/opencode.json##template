{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "instructions": ["~/sync/ai/WORKSTATION.md", "~/storage/shared/sync/ai/WORKSTATION.md"],
  "skills": { "paths": ["{{ env.HOME }}/.claude/plugins/marketplaces/claude-plugins-official/plugins/frontend-design/skills"] },
  "providers": {
    "anthropic": {
      "headers": {
        "anthropic-workspace-id": "{{ env.ANTHROPIC_WORKSPACE_ID }}"
      }
    },
    "dragtokens": {
      "name": "DragTokens",
      "canonical": "openai",
      "package": "@opencode/ai/providers/openai/responses",
      "settings": {
        "baseURL": "http://127.0.0.1:4097/v1",
        "apiKey": "{{ env.DRAGTOKENS_API_KEY }}"
      },
      "models": {
        "gpt-6-astra": {},
        "gpt-6.1-sol": {},
        "gpt-6-sol": {}
      }
    }
  },
  "model": "anthropic/claude-sonnet-4-5",
  "agents": {
    "plan": {
      "model": "dragtokens/gpt-6-astra"
    },
    "build": {
      "model": "dragtokens/gpt-6.1-sol"
    }
  },
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "Bearer {{ env.GITHUB_PERSONAL_ACCESS_TOKEN }}"
        },
        "oauth": false
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false
      },
      "playwright": {
        "type": "local",
        "command": [
          "/usr/local/bin/playwright-mcp",
          "--executable-path",
          "/usr/bin/chromium",
          "--headless",
          "--isolated",
          "--output-dir",
          "{{ env.HOME }}/.cache/playwright-mcp"
        ]
      },
      "memory": {
        "type": "local",
        "command": [
          "/usr/local/bin/mcp-server-memory"
        ],
        "environment": {
{% if env.TERMUX_VERSION != "" %}
          "MEMORY_FILE_PATH": "{{ env.HOME }}/storage/shared/sync/ai/mcp-memory.jsonl"
{% else %}
          "MEMORY_FILE_PATH": "{{ env.HOME }}/sync/ai/mcp-memory.jsonl"
{% endif %}
        }
      },
      "fetch": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/mcp-server-fetch"
        ]
      },
      "git": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/mcp-server-git"
        ]
      },
      "arxiv": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/arxiv-mcp-server",
          "--storage-path",
          "{{ env.HOME }}/Obsidian/Ph.D./Papers/arxiv"
        ]
      },
      "zotero": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/zotero-mcp"
        ],
        "environment": {
          "ZOTERO_LOCAL": "true"
        }
      },
      "markitdown": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/markitdown-mcp"
        ]
      },
      "serena": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/serena",
          "start-mcp-server",
          "--context",
          "ide",
          "--project-from-cwd",
          "--open-web-dashboard",
          "False"
        ],
        "disabled": false
      },
      "nextcloud": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/nextcloud-mcp-server",
          "run",
          "--transport",
          "stdio"
        ],
        "environment": {
          "NEXTCLOUD_HOST": "{{ env.NEXTCLOUD_HOST }}",
          "NEXTCLOUD_USERNAME": "{{ env.NEXTCLOUD_USERNAME }}",
          "NEXTCLOUD_PASSWORD": "{{ env.NEXTCLOUD_PASSWORD }}"
        },
        "disabled": false
      },
      "docker": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/mcp-server-docker"
        ],
        "environment": {
          "DOCKER_HOST": "tcp://127.0.0.1:2375"
        },
        "disabled": false
      },
{% if env.TERMUX_VERSION == "" %}
      "ptsd": {
        "type": "local",
        "command": [
          "/usr/bin/node",
          "{{ env.HOME }}/code/PTSD/mcp/dist/server.mjs"
        ]
      },
      "file-accountant": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/fa",
          "mcp"
        ]
      },
      "package-versions": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/package-version-check-mcp",
          "--mode=stdio"
        ]
      },
      "osv": {
        "type": "local",
        "command": [
          "/usr/bin/osv-scanner",
          "experimental-mcp"
        ]
      },
      "semgrep": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/semgrep",
          "mcp",
          "-t",
          "stdio"
        ],
        "environment": {
          "SEMGREP_SEND_METRICS": "off"
        }
      },
      "openalex": {
        "type": "local",
        "command": [
          "/usr/local/bin/openalex-mcp-server"
        ],
        "environment": {
          "MCP_TRANSPORT_TYPE": "stdio",
          "MCP_LOG_LEVEL": "error"
        }
      },
      "pho-research": {
        "type": "remote",
        "url": "http://127.0.0.1:8787/mcp",
        "oauth": false
      },
      "excalidraw": {
        "type": "local",
        "command": [
          "/usr/local/bin/mcp-excalidraw-server"
        ],
        "disabled": true
      },
      "drawio": {
        "type": "local",
        "command": [
          "/usr/local/bin/drawio-mcp"
        ]
      },
      "obsidian-phd": {
        "type": "remote",
        "url": "http://127.0.0.1:3939/mcp",
        "oauth": false
      },
      "obsidian-adrixan": {
        "type": "remote",
        "url": "http://127.0.0.1:3940/mcp",
        "oauth": false
      },
      "lighthouse": {
        "type": "local",
        "command": [
          "/usr/local/bin/lighthouse-mcp-server"
        ],
        "disabled": true
      },
      "accessibility": {
        "type": "local",
        "command": [
          "/usr/local/bin/accessibility-scanner-mcp"
        ]
      },
      "docs": {
        "type": "remote",
        "url": "http://127.0.0.1:6280/mcp",
        "oauth": false
      },
      "nasa": {
        "type": "local",
        "command": [
          "/usr/local/bin/nasa-mcp-server"
        ],
        "environment": {
          "NASA_API_KEY": "DEMO_KEY"
        },
        "disabled": true
      },
      "open-meteo": {
        "type": "local",
        "command": [
          "/usr/local/bin/open-meteo-mcp-server"
        ],
        "disabled": true
      },
      "wikipedia": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/wikipedia-mcp",
          "--language",
          "en"
        ],
        "disabled": true
      },
      "duckduckgo": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/duckduckgo-mcp-server"
        ],
        "environment": {
          "DDG_SAFE_SEARCH": "MODERATE"
        }
      },
{% endif %}
{% if env.OPENROUTESERVICE_API_KEY != "" %}
      "openroute": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/openroute-mcp",
          "--data-folder",
          "{{ env.HOME }}/Documents/Routes"
        ],
        "environment": {
          "OPENROUTESERVICE_API_KEY": "{{ env.OPENROUTESERVICE_API_KEY }}"
        }
      },
{% endif %}
      "newspaper-testground": {
        "type": "local",
        "command": [
          "ssh",
          "-T",
          "-o",
          "BatchMode=yes",
          "-o",
          "ConnectTimeout=10",
          "-o",
          "ServerAliveInterval=30",
          "ubuntu@testground.code-alongsi.de",
          "cd ~/nexcloud-offline-newspaper && exec ~/.local/bin/uv run --quiet offline-newspaper-mcp --vault-path /home/ubuntu/news_vault --allow-write"
        ],
        "timeout": {
          "startup": 30000,
          "catalog": 30000
        }
      }
    }
  }
}
