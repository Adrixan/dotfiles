{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@frankhommers/opencode-yolo"
  ],
  "provider": {
    "nowcoding": {
      "name": "NowCoding Marketplace",
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "options": {
        "baseURL": "https://nowcoding.ai/v1",
        "apiKey": "{{ env.NOWCODING_API_KEY }}"
      },
      "models": {
        "gpt-5.6-sol": { "modelID": "gpt-5.6-sol", "name": "GPT-5.6 Sol", "limit": { "context": 1050000, "output": 128000 } },
        "claude-opus-5": { "modelID": "claude-opus-5", "name": "Claude Opus 5", "limit": { "context": 1000000, "output": 128000 } },
        "claude-sonnet-5": { "modelID": "claude-sonnet-5", "name": "Claude Sonnet 5", "limit": { "context": 1000000, "output": 128000 } }
      }
    },
    "anthropic": {
      "options": {
        "headers": {
          "anthropic-workspace-id": "{{ env.ANTHROPIC_WORKSPACE_ID }}"
        }
      }
    }  },
  "model": "anthropic/claude-sonnet-4-5",
  "server": {
    "hostname": "127.0.0.1",
    "port": 4096,
    "mdns": false
  },
  "mcp": {
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{{ env.GITHUB_PERSONAL_ACCESS_TOKEN }}"
      },
      "enabled": true
    },
    "puppeteer": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ],
      "enabled": true
    },
    "sqlite": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
        "mcp<=1.1.2",
        "mcp-server-sqlite",
        "--db-path",
        "{{ env.HOME }}/code/workspace.db"
      ],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-fetch"
      ],
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-git"
      ],
      "enabled": true
    },
    "arxiv": {
      "type": "local",
      "command": [
        "uvx",
        "arxiv-mcp-server",
        "--storage-path",
        "{{ env.HOME }}/Obsidian/Ph.D./Papers/arxiv"
      ],
      "enabled": true
    },
    "zotero": {
      "type": "local",
      "command": [
        "uvx",
        "zotero-mcp-server"
      ],
      "environment": {
        "ZOTERO_LOCAL": "true"
      },
      "enabled": true
    }
  }
}
