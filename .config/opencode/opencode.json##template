{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "anthropic": {
      "options": {
        "headers": {
          "anthropic-workspace-id": "{{ env.ANTHROPIC_WORKSPACE_ID }}"
        }
      }
    },
    "dragtokens": {
      "npm": "@ai-sdk/openai",
      "name": "DragTokens",
      "options": {
        "baseURL": "https://dragtokens.com/v1",
        "apiKey": "{{ env.DRAGTOKENS_API_KEY }}"
      },
      "models": {
        "gpt-6-astra": {
          "name": "GPT-6 Astra"
        },
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol"
        },
        "gpt-6-sol": {
          "name": "GPT-6 Sol"
        }
      }
    }
  },
  "model": "anthropic/claude-sonnet-4-5",
  "agent": {
    "plan": {
      "model": "dragtokens/gpt-6-astra"
    },
    "build": {
      "model": "dragtokens/gpt-6.1-sol"
    }
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {{ env.GITHUB_PERSONAL_ACCESS_TOKEN }}"
      },
      "oauth": false,
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "oauth": false,
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "/usr/local/bin/playwright-mcp",
        "--executable-path",
        "/usr/bin/chromium",
        "--headless",
        "--isolated",
        "--output-dir",
        "{{ env.HOME }}/.cache/playwright-mcp"
      ],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": [
        "/usr/local/bin/mcp-server-memory"
      ],
      "environment": {
        "MEMORY_FILE_PATH": "{{ env.HOME }}/sync/ai/mcp-memory.jsonl"
      },
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": [
        "{{ env.HOME }}/.local/bin/mcp-server-fetch"
      ],
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": [
        "{{ env.HOME }}/.local/bin/mcp-server-git"
      ],
      "enabled": true
    },
    "arxiv": {
      "type": "local",
      "command": [
        "{{ env.HOME }}/.local/bin/arxiv-mcp-server",
        "--storage-path",
        "{{ env.HOME }}/Obsidian/Ph.D./Papers/arxiv"
      ],
      "enabled": true
    },
    "zotero": {
      "type": "local",
      "command": [
        "{{ env.HOME }}/.local/bin/zotero-mcp"
      ],
      "environment": {
        "ZOTERO_LOCAL": "true"
      },
      "enabled": true
    },
    "markitdown": {
      "type": "local",
      "command": [
        "{{ env.HOME }}/.local/bin/markitdown-mcp"
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "{{ env.HOME }}/.local/bin/serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd",
        "--open-web-dashboard",
        "False"
      ],
      "enabled": false
    },
    "nextcloud": {
      "type": "local",
      "command": [
        "{{ env.HOME }}/.local/bin/nextcloud-mcp-server",
        "run",
        "--transport",
        "stdio"
      ],
      "environment": {
        "NEXTCLOUD_HOST": "{{ env.NEXTCLOUD_HOST }}",
        "NEXTCLOUD_USERNAME": "{{ env.NEXTCLOUD_USERNAME }}",
        "NEXTCLOUD_PASSWORD": "{{ env.NEXTCLOUD_PASSWORD }}"
      },
      "enabled": false
    },
    "docker": {
      "type": "local",
      "command": [
        "{{ env.HOME }}/.local/bin/mcp-server-docker"
      ],
      "environment": {
        "DOCKER_HOST": "tcp://127.0.0.1:2375"
      },
      "enabled": false
    }
  }
}
