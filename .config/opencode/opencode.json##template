{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "instructions": ["~/sync/ai/WORKSTATION.md", "~/storage/shared/sync/ai/WORKSTATION.md"],
  "skills": { "paths": ["{{ env.HOME }}/.claude/plugins/marketplaces/claude-plugins-official/plugins/frontend-design/skills"] },
  "providers": {
    "anthropic": {
      "headers": {
        "anthropic-workspace-id": "{{ env.ANTHROPIC_WORKSPACE_ID }}"
      }
    },
    "dragtokens": {
      "name": "DragTokens",
      "canonical": "openai",
      "package": "@opencode/ai/providers/openai/responses",
      "settings": {
        "baseURL": "http://127.0.0.1:4097/v1",
        "apiKey": "{{ env.DRAGTOKENS_API_KEY }}"
      },
      "models": {
        "gpt-6-astra": {},
        "gpt-6.1-sol": {},
        "gpt-6-sol": {}
      }
    }
  },
  "model": "anthropic/claude-sonnet-4-5",
  "agents": {
    "plan": {
      "model": "dragtokens/gpt-6-astra"
    },
    "build": {
      "model": "dragtokens/gpt-6.1-sol"
    }
  },
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "Bearer {{ env.GITHUB_PERSONAL_ACCESS_TOKEN }}"
        },
        "oauth": false
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false
      },
      "playwright": {
        "type": "local",
        "command": [
          "/usr/local/bin/playwright-mcp",
          "--executable-path",
          "/usr/bin/chromium",
          "--headless",
          "--isolated",
          "--output-dir",
          "{{ env.HOME }}/.cache/playwright-mcp"
        ]
      },
{% if env.TERMUX_VERSION != "" %}
      "memory": {
        "type": "local",
        "command": [
          "/usr/local/bin/mcp-server-memory"
        ],
        "environment": {
{% if env.TERMUX_VERSION != "" %}
          "MEMORY_FILE_PATH": "{{ env.HOME }}/storage/shared/sync/ai/mcp-memory.jsonl"
{% else %}
          "MEMORY_FILE_PATH": "{{ env.HOME }}/sync/ai/mcp-memory.jsonl"
{% endif %}
        }
      },
{% else %}
      "memory": {"type": "remote", "url": "http://127.0.0.1:8790/servers/memory/mcp", "oauth": false},
{% endif %}
{% if env.TERMUX_VERSION != "" %}
      "fetch": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/mcp-server-fetch"
        ]
      },
{% else %}
      "fetch": {"type": "remote", "url": "http://127.0.0.1:8790/servers/fetch/mcp", "oauth": false},
{% endif %}
      "git": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/mcp-server-git"
        ]
      },
{% if env.TERMUX_VERSION != "" %}
      "arxiv": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/arxiv-mcp-server",
          "--storage-path",
          "{{ env.HOME }}/Obsidian/Ph.D./Papers/arxiv"
        ]
      },
{% else %}
      "arxiv": {"type": "remote", "url": "http://127.0.0.1:8790/servers/arxiv/mcp", "oauth": false},
{% endif %}
{% if env.TERMUX_VERSION != "" %}
      "zotero": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/zotero-mcp"
        ],
        "environment": {
          "ZOTERO_LOCAL": "true"
        }
      },
{% else %}
      "zotero": {"type": "remote", "url": "http://127.0.0.1:8790/servers/zotero/mcp", "oauth": false},
{% endif %}
{% if env.TERMUX_VERSION != "" %}
      "markitdown": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/markitdown-mcp"
        ]
      },
{% else %}
      "markitdown": {"type": "remote", "url": "http://127.0.0.1:8790/servers/markitdown/mcp", "oauth": false},
{% endif %}
      "serena": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/serena",
          "start-mcp-server",
          "--context",
          "ide",
          "--project-from-cwd",
          "--open-web-dashboard",
          "False"
        ],
        "disabled": false
      },
{% if env.TERMUX_VERSION != "" %}
      "nextcloud": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/nextcloud-mcp-server",
          "run",
          "--transport",
          "stdio"
        ],
        "environment": {
          "NEXTCLOUD_HOST": "{{ env.NEXTCLOUD_HOST }}",
          "NEXTCLOUD_USERNAME": "{{ env.NEXTCLOUD_USERNAME }}",
          "NEXTCLOUD_PASSWORD": "{{ env.NEXTCLOUD_PASSWORD }}"
        },
        "disabled": false
      },
{% else %}
      "nextcloud": {"type": "remote", "url": "http://127.0.0.1:8790/servers/nextcloud/mcp", "oauth": false, "disabled": false},
{% endif %}
{% if env.TERMUX_VERSION != "" %}
      "docker": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/mcp-server-docker"
        ],
        "environment": {
          "DOCKER_HOST": "tcp://127.0.0.1:2375"
        },
        "disabled": false
      },
{% else %}
      "docker": {"type": "remote", "url": "http://127.0.0.1:8790/servers/docker/mcp", "oauth": false, "disabled": false},
{% endif %}
{% if env.TERMUX_VERSION == "" %}
      "ptsd": {"type": "remote", "url": "http://127.0.0.1:8790/servers/ptsd/mcp", "oauth": false},
      "file-accountant": {"type": "remote", "url": "http://127.0.0.1:8790/servers/file-accountant/mcp", "oauth": false},
      "package-versions": {"type": "remote", "url": "http://127.0.0.1:8790/servers/package-versions/mcp", "oauth": false},
      "osv": {
        "type": "local",
        "command": [
          "/usr/bin/osv-scanner",
          "experimental-mcp"
        ]
      },
      "semgrep": {
        "type": "local",
        "command": [
          "{{ env.HOME }}/.local/bin/semgrep",
          "mcp",
          "-t",
          "stdio"
        ],
        "environment": {
          "SEMGREP_SEND_METRICS": "off"
        }
      },
      "openalex": {"type": "remote", "url": "http://127.0.0.1:8790/servers/openalex/mcp", "oauth": false},
      "pho-research": {
        "type": "remote",
        "url": "http://127.0.0.1:8787/mcp",
        "oauth": false
      },
      "excalidraw": {"type": "remote", "url": "http://127.0.0.1:8790/servers/excalidraw/mcp", "oauth": false, "disabled": true},
      "drawio": {"type": "remote", "url": "http://127.0.0.1:8790/servers/drawio/mcp", "oauth": false},
      "obsidian-phd": {
        "type": "remote",
        "url": "http://127.0.0.1:3939/mcp",
        "oauth": false
      },
      "obsidian-adrixan": {
        "type": "remote",
        "url": "http://127.0.0.1:3940/mcp",
        "oauth": false
      },
      "lighthouse": {"type": "remote", "url": "http://127.0.0.1:8790/servers/lighthouse/mcp", "oauth": false, "disabled": true},
      "accessibility": {"type": "remote", "url": "http://127.0.0.1:8790/servers/accessibility/mcp", "oauth": false},
      "docs": {
        "type": "remote",
        "url": "http://127.0.0.1:6280/mcp",
        "oauth": false
      },
      "nasa": {"type": "remote", "url": "http://127.0.0.1:8790/servers/nasa/mcp", "oauth": false, "disabled": true},
      "open-meteo": {"type": "remote", "url": "http://127.0.0.1:8790/servers/open-meteo/mcp", "oauth": false, "disabled": true},
      "wikipedia": {"type": "remote", "url": "http://127.0.0.1:8790/servers/wikipedia/mcp", "oauth": false, "disabled": true},
      "duckduckgo": {"type": "remote", "url": "http://127.0.0.1:8790/servers/duckduckgo/mcp", "oauth": false},
      "ris-austria": {"type": "remote", "url": "http://127.0.0.1:8790/servers/ris-austria/mcp", "oauth": false},
      "eur-lex": {"type": "remote", "url": "http://127.0.0.1:8790/servers/eur-lex/mcp", "oauth": false},
      "youtube-transcript": {"type": "remote", "url": "http://127.0.0.1:8790/servers/youtube-transcript/mcp", "oauth": false},
      "oebb": {"type": "remote", "url": "http://127.0.0.1:8790/servers/oebb/mcp", "oauth": false, "disabled": true},
      "thunderbird": {"type": "remote", "url": "http://127.0.0.1:8790/servers/thunderbird/mcp", "oauth": false},
      "trip-scout": {"type": "remote", "url": "http://127.0.0.1:8790/servers/trip-scout/mcp", "oauth": false},
      "trip-planner": {"type": "remote", "url": "http://127.0.0.1:8790/servers/trip-planner/mcp", "oauth": false},
{% endif %}
{% if env.OPENROUTESERVICE_API_KEY != "" %}
      "openroute": {"type": "remote", "url": "http://127.0.0.1:8790/servers/openroute/mcp", "oauth": false},
{% endif %}
      "newspaper-testground": {
        "type": "local",
        "command": [
          "ssh",
          "-T",
          "-o",
          "BatchMode=yes",
          "-o",
          "ConnectTimeout=10",
          "-o",
          "ServerAliveInterval=30",
          "ubuntu@testground.code-alongsi.de",
          "cd ~/nexcloud-offline-newspaper && exec ~/.local/bin/uv run --quiet offline-newspaper-mcp --vault-path /home/ubuntu/news_vault --allow-write"
        ],
        "timeout": {
          "startup": 30000,
          "catalog": 30000
        }
      }
    }
  }
}
