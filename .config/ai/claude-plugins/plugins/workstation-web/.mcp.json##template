{
  "mcpServers": {
{% if env.TERMUX_VERSION == "" %}
    "chrome-devtools": {
      "command": "/usr/local/bin/chrome-devtools-mcp",
      "args": [
        "--executable-path", "/usr/local/libexec/mcp-chromium-sandboxed",
        "--headless",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    }
{% endif %}
  }
}
