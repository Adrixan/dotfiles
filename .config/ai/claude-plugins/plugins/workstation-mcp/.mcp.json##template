{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
{% if env.TERMUX_VERSION != "" %}
    "memory": {
      "command": "/usr/local/bin/mcp-server-memory",
      "env": {
        "MEMORY_FILE_PATH": "${HOME}/storage/shared/sync/ai/mcp-memory.jsonl"
      }
    },
    "fetch": {
      "command": "${HOME}/.local/bin/mcp-server-fetch"
    },
    "markitdown": {
      "command": "${HOME}/.local/bin/markitdown-mcp"
    },
    "nextcloud": {
      "command": "${HOME}/.local/bin/nextcloud-mcp-server",
      "args": ["run", "--transport", "stdio"],
      "env": {
        "NEXTCLOUD_HOST": "${NEXTCLOUD_HOST}",
        "NEXTCLOUD_USERNAME": "${NEXTCLOUD_USERNAME}",
        "NEXTCLOUD_PASSWORD": "${NEXTCLOUD_PASSWORD}"
      }
    }
{% else %}
    "memory": { "type": "http", "url": "http://127.0.0.1:8790/servers/memory/mcp" },
    "fetch": { "type": "http", "url": "http://127.0.0.1:8790/servers/fetch/mcp" },
    "markitdown": { "type": "http", "url": "http://127.0.0.1:8790/servers/markitdown/mcp" },
    "nextcloud": { "type": "http", "url": "http://127.0.0.1:8790/servers/nextcloud/mcp" },
    "package-versions": { "type": "http", "url": "http://127.0.0.1:8790/servers/package-versions/mcp" },
    "duckduckgo": { "type": "http", "url": "http://127.0.0.1:8790/servers/duckduckgo/mcp" },
    "thunderbird": { "type": "http", "url": "http://127.0.0.1:8790/servers/thunderbird/mcp" },
    "docs": { "type": "http", "url": "http://127.0.0.1:6280/mcp" }
{% endif %}
  }
}
