# All htpc web interfaces through one tunnel: `ssh -N htpc-ui`, then http://localhost:<port>
Host htpc-ui
    HostName ssh-htpc.150489.xyz
    User htpc
    ProxyCommand cloudflared access ssh --hostname %h
    IdentityFile ~/.ssh/id_rsa
    ExitOnForwardFailure yes
    ServerAliveInterval 30
    # Seerr, Jellyfin family (LAN address on htpc)
    LocalForward 5055 192.168.179.36:5055
    LocalForward 8096 192.168.179.36:8096
    # Jellyfin parents, Radarr, Sonarr, Prowlarr, Transmission, NZBGet
    LocalForward 8097 127.0.0.1:8097
    LocalForward 7878 127.0.0.1:7878
    LocalForward 8989 127.0.0.1:8989
    LocalForward 9696 127.0.0.1:9696
    LocalForward 9091 127.0.0.1:9091
    LocalForward 6789 127.0.0.1:6789

