{
  "mcpServers": {
    "github": {
      "serverUrl": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {{ env.GITHUB_PERSONAL_ACCESS_TOKEN }}"
      },
      "disabled": false
    },
    "context7": {
      "serverUrl": "https://mcp.context7.com/mcp",
      "disabled": false
    },
    "playwright": {
      "command": "/usr/local/bin/playwright-mcp",
      "args": [
        "--executable-path",
        "/usr/bin/chromium",
        "--headless",
        "--isolated",
        "--output-dir",
        "{{ env.HOME }}/.cache/playwright-mcp"
      ],
      "disabled": false
    },
    "memory": {
      "command": "/usr/local/bin/mcp-server-memory",
      "env": {
{% if env.TERMUX_VERSION != "" %}
        "MEMORY_FILE_PATH": "{{ env.HOME }}/storage/shared/sync/ai/mcp-memory.jsonl"
{% else %}
        "MEMORY_FILE_PATH": "{{ env.HOME }}/sync/ai/mcp-memory.jsonl"
{% endif %}
      },
      "disabled": false
    },
    "fetch": {
      "command": "{{ env.HOME }}/.local/bin/mcp-server-fetch",
      "disabled": false
    },
    "git": {
      "command": "{{ env.HOME }}/.local/bin/mcp-server-git",
      "disabled": false
    },
    "arxiv": {
      "command": "{{ env.HOME }}/.local/bin/arxiv-mcp-server",
      "args": [
        "--storage-path",
        "{{ env.HOME }}/Obsidian/Ph.D./Papers/arxiv"
      ],
      "disabled": false
    },
    "zotero": {
      "command": "{{ env.HOME }}/.local/bin/zotero-mcp",
      "env": {
        "ZOTERO_LOCAL": "true"
      },
      "disabled": false
    },
    "markitdown": {
      "command": "{{ env.HOME }}/.local/bin/markitdown-mcp",
      "disabled": false
    },
    "serena": {
      "command": "{{ env.HOME }}/.local/bin/serena",
      "args": [
        "start-mcp-server",
        "--context=antigravity",
        "--project-from-cwd",
        "--open-web-dashboard",
        "False"
      ],
      "disabled": false
    },
    "nextcloud": {
      "command": "{{ env.HOME }}/.local/bin/nextcloud-mcp-server",
      "args": [
        "run",
        "--transport",
        "stdio"
      ],
      "env": {
        "NEXTCLOUD_HOST": "{{ env.NEXTCLOUD_HOST }}",
        "NEXTCLOUD_USERNAME": "{{ env.NEXTCLOUD_USERNAME }}",
        "NEXTCLOUD_PASSWORD": "{{ env.NEXTCLOUD_PASSWORD }}"
      },
      "disabled": false
    },
    "docker": {
      "command": "{{ env.HOME }}/.local/bin/mcp-server-docker",
      "env": {
        "DOCKER_HOST": "tcp://127.0.0.1:2375"
      },
      "disabled": false
    }
{% if env.TERMUX_VERSION == "" %}
    ,
    "package-versions": {
      "command": "{{ env.HOME }}/.local/bin/package-version-check-mcp",
      "args": [
        "--mode=stdio"
      ],
      "disabled": false
    },
    "osv": {
      "command": "/usr/bin/osv-scanner",
      "args": [
        "experimental-mcp"
      ],
      "disabled": false
    },
    "semgrep": {
      "command": "{{ env.HOME }}/.local/bin/semgrep",
      "args": [
        "mcp",
        "-t",
        "stdio"
      ],
      "env": {
        "SEMGREP_SEND_METRICS": "off"
      },
      "disabled": false
    },
    "openalex": {
      "command": "/usr/local/bin/openalex-mcp-server",
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_LOG_LEVEL": "error"
      },
      "disabled": false
    },
    "pho-research": {
      "serverUrl": "http://127.0.0.1:8787/mcp",
      "disabled": false
    },
    "excalidraw": {
      "command": "/usr/local/bin/mcp-excalidraw-server",
      "disabled": true
    },
    "drawio": {
      "command": "/usr/local/bin/drawio-mcp",
      "disabled": false
    },
    "obsidian-phd": {
      "serverUrl": "http://127.0.0.1:3939/mcp",
      "disabled": false
    },
    "obsidian-adrixan": {
      "serverUrl": "http://127.0.0.1:3940/mcp",
      "disabled": false
    },
    "lighthouse": {
      "command": "/usr/local/bin/lighthouse-mcp-server",
      "disabled": true
    },
    "accessibility": {
      "command": "/usr/local/bin/accessibility-scanner-mcp",
      "disabled": false
    },
    "docs": {
      "serverUrl": "http://127.0.0.1:6280/mcp",
      "disabled": false
    },
    "nasa": {
      "command": "/usr/local/bin/nasa-mcp-server",
      "env": {
        "NASA_API_KEY": "DEMO_KEY"
      },
      "disabled": true
    },
    "open-meteo": {
      "command": "/usr/local/bin/open-meteo-mcp-server",
      "disabled": true
    },
    "wikipedia": {
      "command": "{{ env.HOME }}/.local/bin/wikipedia-mcp",
      "args": [
        "--language",
        "en"
      ],
      "disabled": true
    },
    "duckduckgo": {
      "command": "{{ env.HOME }}/.local/bin/duckduckgo-mcp-server",
      "env": {
        "DDG_SAFE_SEARCH": "MODERATE"
      },
      "disabled": false
    },
    "ris-austria": {
      "command": "/usr/local/bin/ris-austria-mcp-server",
      "disabled": false
    },
    "eur-lex": {
      "command": "/usr/local/bin/eur-lex-mcp-server",
      "disabled": false
    },
    "youtube-transcript": {
      "command": "{{ env.HOME }}/.local/bin/mcp-youtube-transcript",
      "disabled": false
    },
    "oebb": {
      "command": "{{ env.HOME }}/.local/bin/oebb-mcp-server",
      "disabled": true
    },
    "thunderbird": {
      "command": "/usr/local/bin/thunderbird-mcp",
      "disabled": false
    },
    "trip-scout": {
      "command": "{{ env.HOME }}/.local/bin/trip-scout",
      "args": ["mcp"],
      "disabled": false
    },
    "trip-planner": {
      "command": "{{ env.HOME }}/.local/bin/trip-planner",
      "args": ["mcp"],
      "disabled": false
    }
{% endif %}
{% if env.OPENROUTESERVICE_API_KEY != "" %}
    ,
    "openroute": {
      "command": "{{ env.HOME }}/.local/bin/openroute-mcp",
      "args": [
        "--data-folder",
        "{{ env.HOME }}/Documents/Routes"
      ],
      "env": {
        "OPENROUTESERVICE_API_KEY": "{{ env.OPENROUTESERVICE_API_KEY }}"
      },
      "disabled": false
    }
{% endif %}
  }
}
