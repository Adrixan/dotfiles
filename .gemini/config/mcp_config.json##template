{
  "mcpServers": {
    "github": {
      "serverUrl": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {{ env.GITHUB_PERSONAL_ACCESS_TOKEN }}"
      },
      "disabled": false
    },
    "context7": {
      "serverUrl": "https://mcp.context7.com/mcp",
      "disabled": false
    },
    "playwright": {
      "command": "/usr/local/bin/playwright-mcp",
      "args": [
        "--executable-path",
        "/usr/bin/chromium",
        "--headless",
        "--isolated",
        "--output-dir",
        "{{ env.HOME }}/.cache/playwright-mcp"
      ],
      "disabled": false
    },
{% if env.TERMUX_VERSION != "" %}
    "memory": {
      "command": "/usr/local/bin/mcp-server-memory",
      "env": {
{% if env.TERMUX_VERSION != "" %}
        "MEMORY_FILE_PATH": "{{ env.HOME }}/storage/shared/sync/ai/mcp-memory.jsonl"
{% else %}
        "MEMORY_FILE_PATH": "{{ env.HOME }}/sync/ai/mcp-memory.jsonl"
{% endif %}
      },
      "disabled": false
    },
{% else %}
    "memory": {"serverUrl": "http://127.0.0.1:8790/servers/memory/mcp", "disabled": false},
{% endif %}
{% if env.TERMUX_VERSION != "" %}
    "fetch": {
      "command": "{{ env.HOME }}/.local/bin/mcp-server-fetch",
      "disabled": false
    },
{% else %}
    "fetch": {"serverUrl": "http://127.0.0.1:8790/servers/fetch/mcp", "disabled": false},
{% endif %}
    "git": {
      "command": "{{ env.HOME }}/.local/bin/mcp-server-git",
      "disabled": false
    },
{% if env.TERMUX_VERSION != "" %}
    "arxiv": {
      "command": "{{ env.HOME }}/.local/bin/arxiv-mcp-server",
      "args": [
        "--storage-path",
        "{{ env.HOME }}/Obsidian/Ph.D./Papers/arxiv"
      ],
      "disabled": false
    },
{% else %}
    "arxiv": {"serverUrl": "http://127.0.0.1:8790/servers/arxiv/mcp", "disabled": false},
{% endif %}
{% if env.TERMUX_VERSION != "" %}
    "zotero": {
      "command": "{{ env.HOME }}/.local/bin/zotero-mcp",
      "env": {
        "ZOTERO_LOCAL": "true"
      },
      "disabled": false
    },
{% else %}
    "zotero": {"serverUrl": "http://127.0.0.1:8790/servers/zotero/mcp", "disabled": false},
{% endif %}
{% if env.TERMUX_VERSION != "" %}
    "markitdown": {
      "command": "{{ env.HOME }}/.local/bin/markitdown-mcp",
      "disabled": false
    },
{% else %}
    "markitdown": {"serverUrl": "http://127.0.0.1:8790/servers/markitdown/mcp", "disabled": false},
{% endif %}
    "serena": {
      "command": "{{ env.HOME }}/.local/bin/serena",
      "args": [
        "start-mcp-server",
        "--context=antigravity",
        "--project-from-cwd",
        "--open-web-dashboard",
        "False"
      ],
      "disabled": false
    },
{% if env.TERMUX_VERSION != "" %}
    "nextcloud": {
      "command": "{{ env.HOME }}/.local/bin/nextcloud-mcp-server",
      "args": [
        "run",
        "--transport",
        "stdio"
      ],
      "env": {
        "NEXTCLOUD_HOST": "{{ env.NEXTCLOUD_HOST }}",
        "NEXTCLOUD_USERNAME": "{{ env.NEXTCLOUD_USERNAME }}",
        "NEXTCLOUD_PASSWORD": "{{ env.NEXTCLOUD_PASSWORD }}"
      },
      "disabled": false
    },
{% else %}
    "nextcloud": {"serverUrl": "http://127.0.0.1:8790/servers/nextcloud/mcp", "disabled": false},
{% endif %}
{% if env.TERMUX_VERSION != "" %}
    "docker": {
      "command": "{{ env.HOME }}/.local/bin/mcp-server-docker",
      "env": {
        "DOCKER_HOST": "tcp://127.0.0.1:2375"
      },
      "disabled": false
    }
{% else %}
    "docker": {"serverUrl": "http://127.0.0.1:8790/servers/docker/mcp", "disabled": false}
{% endif %}
{% if env.TERMUX_VERSION == "" %}
    ,
    "package-versions": {"serverUrl": "http://127.0.0.1:8790/servers/package-versions/mcp", "disabled": false},
    "osv": {
      "command": "/usr/bin/osv-scanner",
      "args": [
        "experimental-mcp"
      ],
      "disabled": false
    },
    "semgrep": {
      "command": "{{ env.HOME }}/.local/bin/semgrep",
      "args": [
        "mcp",
        "-t",
        "stdio"
      ],
      "env": {
        "SEMGREP_SEND_METRICS": "off"
      },
      "disabled": false
    },
    "openalex": {"serverUrl": "http://127.0.0.1:8790/servers/openalex/mcp", "disabled": false},
    "pho-research": {
      "serverUrl": "http://127.0.0.1:8787/mcp",
      "disabled": false
    },
    "excalidraw": {"serverUrl": "http://127.0.0.1:8790/servers/excalidraw/mcp", "disabled": true},
    "drawio": {"serverUrl": "http://127.0.0.1:8790/servers/drawio/mcp", "disabled": false},
    "obsidian-phd": {
      "serverUrl": "http://127.0.0.1:3939/mcp",
      "disabled": false
    },
    "obsidian-adrixan": {
      "serverUrl": "http://127.0.0.1:3940/mcp",
      "disabled": false
    },
    "lighthouse": {"serverUrl": "http://127.0.0.1:8790/servers/lighthouse/mcp", "disabled": true},
    "accessibility": {"serverUrl": "http://127.0.0.1:8790/servers/accessibility/mcp", "disabled": false},
    "docs": {
      "serverUrl": "http://127.0.0.1:6280/mcp",
      "disabled": false
    },
    "nasa": {"serverUrl": "http://127.0.0.1:8790/servers/nasa/mcp", "disabled": true},
    "open-meteo": {"serverUrl": "http://127.0.0.1:8790/servers/open-meteo/mcp", "disabled": true},
    "wikipedia": {"serverUrl": "http://127.0.0.1:8790/servers/wikipedia/mcp", "disabled": true},
    "duckduckgo": {"serverUrl": "http://127.0.0.1:8790/servers/duckduckgo/mcp", "disabled": false},
    "ris-austria": {"serverUrl": "http://127.0.0.1:8790/servers/ris-austria/mcp", "disabled": false},
    "eur-lex": {"serverUrl": "http://127.0.0.1:8790/servers/eur-lex/mcp", "disabled": false},
    "youtube-transcript": {"serverUrl": "http://127.0.0.1:8790/servers/youtube-transcript/mcp", "disabled": false},
    "oebb": {"serverUrl": "http://127.0.0.1:8790/servers/oebb/mcp", "disabled": true},
    "thunderbird": {"serverUrl": "http://127.0.0.1:8790/servers/thunderbird/mcp", "disabled": false},
    "trip-scout": {"serverUrl": "http://127.0.0.1:8790/servers/trip-scout/mcp", "disabled": false},
    "trip-planner": {"serverUrl": "http://127.0.0.1:8790/servers/trip-planner/mcp", "disabled": false}
{% endif %}
{% if env.OPENROUTESERVICE_API_KEY != "" %}
    ,
    "openroute": {"serverUrl": "http://127.0.0.1:8790/servers/openroute/mcp", "disabled": false}
{% endif %}
  }
}
